{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run NoteVision AI (Streamlit)",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": ["run", "app.py", "--server.port", "8501", "--browser.gatherUsageStats", "false"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Run tests (pytest)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["-q"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ]
}
